# Application Settings
APP_NAME=UzAssets Payment Calendar Risk Forecast
PORT=8002
LOG_LEVEL=INFO

# AI Provider Selection: GEMINI or GEMMA (via vLLM)
DEFAULT_AI_MODEL=GEMINI
RISK_DEFAULT_AI_MODEL=GEMINI

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_HTTP_TIMEOUT_SEC=35

# Local vLLM Configuration (Alternative to Gemini)
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=
VLLM_MODEL=gemma4-31b
VLLM_TIMEOUT_SEC=180
VLLM_MAX_TOKENS=8192

# Backend API URL (for upstream Treasury system)
BACKEND_API_BASE_URL=https://api.uz-assets.uz/api/v1
